DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@DISPOSABLE_TEST_HOST/DBNAME?sslmode=require
NEXT_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_BACKOFF_BASE_SECONDS=0.5
EMBEDDING_BACKOFF_MAX_SECONDS=8
EMBEDDING_BATCH_DELAY_SECONDS=0.1
SEARCH_MAX_TOP_K=20
SEARCH_MIN_SIMILARITY=0.0
UPLOAD_DIRECTORY=.local/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=200
CHUNK_SIZE=900
CHUNK_OVERLAP=150
