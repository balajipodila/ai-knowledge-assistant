DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@DISPOSABLE_TEST_HOST/DBNAME?sslmode=require
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_BACKOFF_BASE_SECONDS=0.5
EMBEDDING_BACKOFF_MAX_SECONDS=8
EMBEDDING_BATCH_DELAY_SECONDS=0.1
SEARCH_MAX_TOP_K=20
SEARCH_MIN_SIMILARITY=0.0
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Optional. Set only to a model available to your Gemini API key.
# GEMINI_CHAT_FALLBACK_MODEL=
TRUSTED_PROXY_CIDRS=[]
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
CHAT_REQUESTS_PER_MINUTE=5
CHAT_REQUESTS_PER_DAY=100
CHAT_CONCURRENT_REQUESTS_PER_USER=2
UPLOAD_REQUESTS_PER_MINUTE=3
UPLOAD_REQUESTS_PER_DAY=20
SEARCH_REQUESTS_PER_MINUTE=20
SEARCH_REQUESTS_PER_DAY=500
AUTH_EMAIL_ATTEMPTS_PER_MINUTE=5
AUTH_IP_ATTEMPTS_PER_MINUTE=20
MAX_DOCUMENTS_PER_USER=25
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_GENERATION_DEADLINE_SECONDS=30
CHAT_ATTEMPT_TIMEOUT_SECONDS=15
CHAT_MAX_QUESTION_CHARS=2000
CHAT_MAX_CONTEXT_CHUNKS=5
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_MAX_ATTEMPTS=3
CHAT_BACKOFF_BASE_SECONDS=0.5
CHAT_BACKOFF_MAX_SECONDS=4
UPLOAD_DIRECTORY=.local/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=200
CHUNK_SIZE=900
CHUNK_OVERLAP=150
S3_CONNECT_TIMEOUT_SECONDS=5.0
S3_READ_TIMEOUT_SECONDS=30.0
S3_MAX_ATTEMPTS=3
S3_REQUEST_CHECKSUM_CALCULATION=when_supported
S3_RESPONSE_CHECKSUM_VALIDATION=when_required
